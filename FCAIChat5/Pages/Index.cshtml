@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@* チャット画面 (メッセージの一覧と入力欄) *@
<div class="container">
    @* メッセージの一覧 (部分ビュー _MessagePartial で 1 件ずつふきだしで表示する) *@
    <div class="row p-1">
        <div class="col-8">
            <div id="messagesList" class="talk1">
                @if (Model?.Messages is not null) {
                    @foreach (var message in Model.Messages) {
                        <partial name="_MessagePartial" model="message" />
                    }
                }
            </div>
        </div>
    </div>
    <div class="row p-1">
        <div class="col-8">
            <hr />
        </div>
    </div>
    @* 送信者名 (ログインしているユーザーの名前)。画面には表示せず、chat.js が送信時に読み取る *@
    <div class="row p-1" hidden="hidden">
        <div class="col-2">User</div>
        <div class="col-6"><input type="text" id="userInput" value="@User?.Identity?.Name" /></div>
    </div>
    @* メッセージの入力欄 *@
    <div class="row p-1">
        <div class="col-2">Message</div>
        <div class="col-6"><input type="text" class="w-100" id="messageInput" /></div>
    </div>
    @* 送信ボタン *@
    <div class="row p-1">
        <div class="col-8 text-end">
            <input type="button" id="sendButton" value="Send Message" />
            @* 新: 会話とメッセージ履歴をクリアするボタン *@
            <input type="button" id="clearButton" value="Clear" />
        </div>
    </div>
</div>
@* チャット画面のスクリプト (ES モジュールとして読み込む) *@
@section Scripts {
    <script type="module" src="~/js/chat.js"></script>
}
